    <string name="apps_details_wakelocks_title">Wakelocks</string>
    <string name="apps_details_wakelocks_info_title">About wakelocks</string>
    <string name="apps_details_wakelocks_info_body">A wakelock keeps the phone from sleeping while an app works. Each is named by the app. Long CPU wakelocks with the screen off are a common cause of drain.\n\nTimes are pooled: when several apps hold wakelocks at once, Android splits the time between them.</string>
    <string name="apps_details_wakelock_cpu">keeps the CPU on</string>
    <string name="apps_details_wakelock_screen">keeps the screen on</string>
