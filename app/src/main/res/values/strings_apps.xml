    <string name="apps_details_history_series">Battery used</string>
    <string name="apps_details_history_info_title">About sessions on battery</string>
    <string name="apps_details_history_info_body">Each bar is one time on battery in the last 30 days (up to 14), from unplug to plug-in. Voltwise reads Android\'s stats at both ends when it has access, and keeps the top 30 apps by battery use plus up to 10 additional apps that wake the phone.\n\nA session where this app wasn\'t individually stored shows as 0.</string>
