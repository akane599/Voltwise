    <string name="now_duration_minutes">%1$s min</string>
    <string name="now_duration_under_minute">&lt;1 min</string>
    <!-- A compact duration cell: "2:10" with this unit, or "45" with the minutes one -->
    <string name="now_unit_hours">h</string>
    <string name="now_unit_minutes">min</string>

