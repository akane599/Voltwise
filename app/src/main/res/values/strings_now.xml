    <!-- Since unplug (the monitoring window) -->
    <string name="now_since_title">Since unplug</string>
    <string name="now_since_title_at">Since unplug · %1$s</string>
    <string name="now_since_title_last">Last on battery · %1$s–%2$s</string>
    <string name="now_since_empty">Start monitoring to see how fast the battery drains with the screen on and off.</string>
    <string name="now_since_empty_monitoring">Appears once the phone runs on battery.</string>
    <string name="now_screen_on">Screen on</string>
    <string name="now_screen_off">Screen off</string>
    <string name="now_deep_sleep">Deep sleep</string>
    <string name="now_drain_supporting">%1$s mA · %2$s</string>
    <string name="now_reset">Reset</string>
    <string name="now_reset_title">Reset these numbers?</string>
    <string name="now_reset_body">Screen on, screen off and deep sleep start again from now. Saved history is kept.</string>
    <string name="now_reset_confirm">Reset</string>
    <string name="now_cancel">Cancel</string>
    <string name="now_since_info_title">About since unplug</string>
    <string name="now_since_info_body">Since unplug counts from the moment the phone was last unplugged, or from your last Reset; a gap in monitoring also starts a new window. While the phone is plugged in, the last time on battery is shown instead.\n\nScreen on and screen off count only time on battery. The first number is the average drain per hour as a share of the battery\'s full capacity; mA is the same drain as current.\n\nDeep sleep is how much of the time the processor was fully asleep. With the screen off it should be high: if it is low, something is keeping the phone awake.</string>

