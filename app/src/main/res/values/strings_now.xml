    <string name="now_range_live">Live</string>
    <string name="now_range_hour">1h</string>
    <string name="now_range_six_hours">6h</string>
    <string name="now_range_day">24h</string>
    <string name="now_range_label">Trace range</string>
    <string name="now_trace_series">Current</string>
