    <string name="now_today_title">Today</string>
    <string name="now_today_used">Used</string>
    <string name="now_today_charged">Charged</string>
    <string name="now_today_screen_on">Screen on</string>
    <string name="now_today_empty">Nothing recorded yet today.</string>

