    <string name="insights_side_standby_rare">Messages and updates from this app may arrive late.</string>
    <string name="insights_side_force_stop">Unsaved work in the app is lost, and its alarms and notifications stop until it runs again.</string>
    <string name="insights_side_remove_doze_whitelist">While the phone is idle, this app may sync and notify later.</string>
