    <!-- ActionType: exact effect -->
    <string name="insights_effect_restrict_background">Applies Android\'s background-activity restriction to this app. Android exemptions can still allow background activity.</string>
    <string name="insights_effect_standby_restricted">Moves this app to Android\'s Restricted standby bucket: its jobs and alarms run at most about once a day.</string>
    <string name="insights_effect_standby_rare">Moves this app to Android\'s Rare standby bucket: its jobs and alarms are held back for hours.</string>
    <string name="insights_effect_force_stop">Stops this app and its background work right now. It starts normally the next time you open it.</string>
    <string name="insights_effect_remove_doze_whitelist">Removes this app from Android\'s battery optimization exemptions, so Doze limits it like other apps.</string>
    <string name="insights_effect_open_app_settings">Opens this app\'s page in Android\'s settings. Nothing changes until you change it there.</string>
    <string name="insights_effect_open_battery_optimization">Opens Android\'s battery optimization list. Nothing changes until you change it there.</string>
    <string name="insights_effect_enable_high_battery_alert">Turns on Voltwise\'s high-battery alert, so you know when to unplug.</string>

    <!-- ActionType: side effects -->
    <string name="insights_side_restrict_background">Notifications, sync and widgets that rely on background work may arrive late or stop until you open the app.</string>
